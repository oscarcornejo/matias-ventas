generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENTE
}

enum OrderStatus {
  PENDIENTE
  PAGADA
  RECHAZADA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  role         Role     @default(CLIENTE)
  /// Hash bcrypt de la contraseña. La tienen el administrador y los clientes registrados.
  passwordHash String?
  createdAt    DateTime @default(now())
  orders       Order[]
}

/// Catálogo de la tienda. Es la fuente de verdad de los precios: el servidor
/// los lee desde aquí al cobrar y nunca confía en lo que mande el navegador.
model Product {
  id    String @id @default(cuid())
  name  String
  /// Precio en pesos chilenos (CLP, entero). El peso no usa decimales.
  price Int
  /// Marcador visual mientras no haya fotografía.
  emoji String @default("🍬")
  /// Oculto deja de aparecer en la tienda pero conserva el producto y su historial.
  visible   Boolean  @default(true)
  /// Orden de aparición en la tienda; a igualdad, por fecha de creación.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, position])
  promoItems PromoItem[]
  images     Image[]
}

/// Fotos de un producto o de un combo. Varias por ítem, en el orden que define
/// Matías: la primera es la que se ve en la tarjeta y el resto, en el carrusel.
///
/// Viven en la base y no en disco porque el sistema de archivos de los servicios
/// gestionados se borra en cada despliegue. El navegador las redimensiona antes
/// de subirlas, así que son archivos chicos.
model Image {
  id       String @id @default(cuid())
  data     Bytes
  type     String
  position Int    @default(0)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  promoId   String?
  promo     Promo?   @relation(fields: [promoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId, position])
  @@index([promoId, position])
}

/// Combo: varios productos vendidos juntos a un precio fijo que define Matías.
/// El precio del combo NO se calcula desde sus partes: es el que él escribe.
model Promo {
  id    String @id @default(cuid())
  name  String
  /// Precio del combo completo en pesos chilenos (entero).
  price Int
  emoji String @default("🎁")
  /// Oculto deja de aparecer en la tienda pero conserva el combo y su historial.
  visible   Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     PromoItem[]
  images    Image[]

  @@index([visible, position])
}

/// Qué lleva un combo y cuánto de cada cosa.
model PromoItem {
  id        String  @id @default(cuid())
  promoId   String
  promo     Promo   @relation(fields: [promoId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([promoId, productId])
  @@index([productId])
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PENDIENTE)
  /// Total en pesos chilenos (CLP, entero).
  total          Int
  mpPreferenceId String?
  mpPaymentId    String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  /// Nombre y precio quedan fijados al momento de la compra.
  name      String
  unitPrice Int
  quantity  Int

  @@index([orderId])
}
