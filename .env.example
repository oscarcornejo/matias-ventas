# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# PostgreSQL (docker compose levanta esta base en local)
DATABASE_URL="postgresql://mati:mati@localhost:5432/mati_ventas?schema=public"

# Clave para firmar la cookie de sesión (mínimo 32 caracteres).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Contraseña del administrador (matiasalecornejo@gmail.com).
# Solo se guarda su hash bcrypt en la base de datos.
ADMIN_PASSWORD=""

# Mercado Pago Chile (credenciales del usuario de prueba VENDEDOR en desarrollo)
MP_ACCESS_TOKEN=""
# Clave secreta de las notificaciones Webhooks (panel de tu aplicación > Webhooks)
MP_WEBHOOK_SECRET=""

# URL pública de la app. En local, la URL de tu túnel (ngrok / cloudflared) hacia el puerto 5173.
APP_URL="http://localhost:5173"

PORT=3000
